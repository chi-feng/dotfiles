#!/usr/bin/env bash
# with-secret NAME [NAME...] -- cmd args...
# Run one command with break-glass values in its environment, and append the use to
# ~/.local/state/secrets/audit.log. Break-glass values never load at shell start.
set -euo pipefail

names=()
while [[ $# -gt 0 && "$1" != "--" ]]; do names+=("$1"); shift; done
[[ "${1:-}" == "--" ]] && shift
if [[ ${#names[@]} -eq 0 || $# -eq 0 ]]; then
  echo "usage: with-secret NAME [NAME...] -- cmd args..." >&2
  exit 2
fi

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
assign=()
for n in "${names[@]}"; do
  v="$("$here/secrets" get "$n" --store breakglass)" || { echo "with-secret: no break-glass value for $n" >&2; exit 1; }
  assign+=("$n=$v")
done

log="$HOME/.local/state/secrets/audit.log"
mkdir -p "$(dirname "$log")"; chmod 700 "$(dirname "$log")"
printf '%s %s -- %s\n' "$(date -u +%FT%TZ)" "${names[*]}" "$*" >> "$log"
exec env "${assign[@]}" "$@"
