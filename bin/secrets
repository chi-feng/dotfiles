#!/usr/bin/env bash
# secrets: KEY=value blobs in the OS secret store, exported into shells by ~/.zshenv.
#
#   secrets list   [--store S]          print the names in the store
#   secrets get    NAME [--store S]     print one value
#   secrets set    NAME [VALUE] [--store S]   add or replace one entry (VALUE from stdin when omitted)
#   secrets unset  NAME [--store S]     remove one entry
#   secrets edit   [--store S]          open the blob in $EDITOR through a 0600 temp file
#   secrets export [--store S]          shell `export` lines, for eval in scripts and launchd jobs
#   secrets json   [--store S]          the blob as a JSON object, for a cloud secrets manager
#   secrets import FILE [--store S]     replace the blob with a KEY=value file ("-" reads stdin)
#
# Stores: main (default) and breakglass. On macOS each store is a login-Keychain item
# (shell-env, shell-env-breakglass) holding the blob base64-encoded, because
# `security -w` prints a multi-line value as hex. On Linux each store is
# ~/.config/secrets/<item> at mode 0600. Reads never prompt.
set -euo pipefail

store=main
args=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --store) store="$2"; shift 2 ;;
    --store=*) store="${1#--store=}"; shift ;;
    *) args+=("$1"); shift ;;
  esac
done
set -- "${args[@]+"${args[@]}"}"

case "$store" in
  main) item=shell-env ;;
  breakglass) item=shell-env-breakglass ;;
  *) echo "secrets: unknown store '$store' (main or breakglass)" >&2; exit 2 ;;
esac
user="${USER:-$(id -un)}"
linux_file="$HOME/.config/secrets/$item"

read_blob() {
  if [[ "$OSTYPE" == darwin* ]]; then
    /usr/bin/security find-generic-password -a "$user" -s "$item" -w 2>/dev/null | base64 -d 2>/dev/null || true
  elif [[ -r "$linux_file" ]]; then
    cat "$linux_file"
  fi
}

write_blob() {  # blob on stdin
  local blob; blob="$(cat)"
  if [[ "$OSTYPE" == darwin* ]]; then
    /usr/bin/security add-generic-password -a "$user" -s "$item" -w "$(printf '%s\n' "$blob" | base64)" -U >/dev/null
  else
    mkdir -p "$(dirname "$linux_file")"; chmod 700 "$(dirname "$linux_file")"
    (umask 077; printf '%s\n' "$blob" > "$linux_file")
  fi
}

valid_name() { [[ "$1" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || { echo "secrets: bad name '$1'" >&2; exit 2; }; }
entries() { read_blob | grep -E '^[A-Za-z_][A-Za-z0-9_]*=' || true; }

cmd="${1:-}"; shift || true
case "$cmd" in
  list)
    entries | cut -d= -f1 ;;
  get)
    [[ $# -eq 1 ]] || { echo "usage: secrets get NAME" >&2; exit 2; }
    valid_name "$1"
    v="$(entries | sed -n "s/^$1=//p" | tail -n 1)"
    [[ -n "$v" ]] || { echo "secrets: no value for $1 in store $store" >&2; exit 1; }
    printf '%s\n' "$v" ;;
  set)
    [[ $# -ge 1 && $# -le 2 ]] || { echo "usage: secrets set NAME [VALUE]" >&2; exit 2; }
    valid_name "$1"
    if [[ $# -eq 2 ]]; then v="$2"; else v="$(cat)"; v="${v%$'\n'}"; fi
    [[ "$v" != *$'\n'* ]] || { echo "secrets: values are single-line" >&2; exit 2; }
    { entries | grep -v "^$1=" || true; printf '%s=%s\n' "$1" "$v"; } | write_blob
    echo "secrets: set $1 in store $store" >&2 ;;
  unset)
    [[ $# -eq 1 ]] || { echo "usage: secrets unset NAME" >&2; exit 2; }
    valid_name "$1"
    entries | grep -v "^$1=" | write_blob || true
    echo "secrets: removed $1 from store $store" >&2 ;;
  edit)
    tmpdir="$(mktemp -d)"; chmod 700 "$tmpdir"; tmp="$tmpdir/$item"
    trap 'rm -rf "$tmpdir"' EXIT
    (umask 077; read_blob > "$tmp")
    before="$(shasum "$tmp")"
    "${EDITOR:-vim}" "$tmp"
    if [[ "$(shasum "$tmp")" == "$before" ]]; then echo "secrets: no change" >&2; exit 0; fi
    grep -E '^[A-Za-z_][A-Za-z0-9_]*=' "$tmp" | write_blob
    echo "secrets: updated store $store ($(grep -cE '^[A-Za-z_][A-Za-z0-9_]*=' "$tmp") entries)" >&2 ;;
  export)
    entries | while IFS= read -r line; do printf 'export %s=%q\n' "${line%%=*}" "${line#*=}"; done ;;
  json)
    entries | python3 -c 'import json,sys; print(json.dumps(dict(l.rstrip("\n").split("=",1) for l in sys.stdin if "=" in l), indent=2))' ;;
  import)
    [[ $# -eq 1 ]] || { echo "usage: secrets import FILE" >&2; exit 2; }
    src="$1"; [[ "$src" == "-" ]] && src=/dev/stdin
    grep -E '^[A-Za-z_][A-Za-z0-9_]*=' "$src" | write_blob
    echo "secrets: replaced store $store" >&2 ;;
  ""|-h|--help|help)
    sed -n '2,15p' "$0" ;;
  *)
    echo "secrets: unknown command '$cmd'" >&2; sed -n '2,15p' "$0" >&2; exit 2 ;;
esac
